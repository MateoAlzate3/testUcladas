@model WebAppVeterinaria.Models.Veterinaria

@{
    ViewData["Title"] = "Create";
}

<h1>Crear nueva Veterinaria</h1>

<h4>Veterinaria</h4>
<hr />
<div class="col s12 l9">
    <div class="row">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col s12 input-field">
                    <label asp-for="Nit" class="control-label"></label>
                    <input asp-for="Nit" class="form-contro" />
                    <span asp-validation-for="Nit" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col s12 input-field">
                    <label asp-for="RazonSocial" class="control-label"></label>
                    <input asp-for="RazonSocial" class="form-control" />
                    <span asp-validation-for="RazonSocial" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col s12 input-field">
                    <label asp-for="Direccion" class="control-label"></label>
                    <input asp-for="Direccion" class="form-control" />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col s12 input-field">
                    <label asp-for="Telefono" class="control-label"></label>
                    <input asp-for="Telefono" class="form-control" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col s12 input-field">
                    <label asp-for="Email" class="control-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col s12 input-field">
                    <label asp-for="Empleados" class="control-label"></label>
                    <input asp-for="Empleados" class="form-control" />
                    <span asp-validation-for="Empleados" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col s12 input-field">
                    <label asp-for="FechaFundacion" class="control-label"></label>
                    <input asp-for="FechaFundacion" type="text" class="datepicker" />
                    <span asp-validation-for="FechaFundacion" class="text-danger"></span>
                </div>
            </div>
            
            <div class="col s12 center">
                <button type="submit" class="btn waves-effect waves-light light-green darken-2" style="padding: 0px 10px; font-size: 14px; border-radius: 8px;">
                    <i class="material-icons left">person_add</i>Crear</button>
            </div>
                       
        </form>
        
        <div style="margin-top: 6px;">
            <a asp-action="Index" class="waves-effect waves-light"
               style="color: #2196F3; text-decoration: none; font-size: 16px; display: inline-flex; align-items: center;">
                <i class="material-icons left" style="font-size: 16px; margin-right: 4px;">arrow_back</i> Regresar</a>
        </div>
        
    </div>
</div>




