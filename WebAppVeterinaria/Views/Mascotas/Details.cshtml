@model WebAppVeterinaria.Models.Mascota

@{
    ViewData["Title"] = "Details";
}

<div class="container">
    <div class="center-align">
        <h3>Detalles de la Mascota</h3>
    </div>

    <div class="card-panel grey lighten-5">
        <h4>Informacion de la Mascota:</h4>
        <hr/>

        <table class="responsive-table">
            <tbody>
                <tr>
                    <td><strong>Nombre:</strong></td>
                    <td>@Html.DisplayFor(model => model.Nombre)</td>
                </tr>
                <tr>
                    <td><strong>Especie:</strong></td>
                    <td>@Html.DisplayFor(model => model.Especie)</td>
                </tr>
                <tr>
                    <td><strong>Raza:</strong></td>
                    <td>@Html.DisplayFor(model => model.Raza)</td>
                </tr>
                <tr>
                    <td><strong>Color:</strong></td>
                    <td>@Html.DisplayFor(model => model.Color)</td>
                </tr>
                <tr>
                    <td><strong>Fecha de Nacimiento:</strong></td>
                    <td>@Html.DisplayFor(model => model.FechaNacimiento)</td>
                </tr>
                <tr>
                    <td><strong>Propietario:</strong></td>
                    <td>@Html.DisplayFor(model => model.Propietario)</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="center-align">
    <a asp-action="Edit" asp-route-id="@Model?.id" class="btn waves-effect waves-light indigo darken-2" style="padding: 0px 10px; font-size: 14px; border-radius: 8px;">
        <i class="material-icons left">edit</i>Editar
    </a>
    <a asp-action="Index" style="color: #2196F3; text-decoration: none; font-size: 16px; display: inline-flex; align-items: center;">
        <i class="material-icons left" style="font-size: 16px; margin-right: 4px;">arrow_back</i> Volver a la Lista
    </a>
</div>

