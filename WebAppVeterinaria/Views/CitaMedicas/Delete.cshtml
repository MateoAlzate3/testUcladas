@model WebAppVeterinaria.Models.CitaMedica

@{
    ViewData["Title"] = "Delete";
}


<div class=" container">
    <h3>¿Estás seguro de que deseas eliminar esta cita médica?</h3>

    <div class="card-panel grey lighten-5">
        <h4>Eliminar cita de la mascota: <td>@Html.DisplayFor(model => model.Mascota.Nombre)</td></h4>
        <hr />

        <table class="responsive-table">
            <tbody>
                <tr>
                    <td><strong>Fecha Cita:</strong></td>
                    <td>@Html.DisplayFor(model => model.FechaCita)</td>
                </tr>
                <tr>
                    <td><strong>Sintomas:</strong></td>
                    <td>@Html.DisplayFor(model => model.Sintomas)</td>
                </tr>
                <tr>
                    <td><strong>Diagnostico:</strong></td>
                    <td>@Html.DisplayFor(model => model.Diagnostico)</td>
                </tr>
                <tr>
                    <td><strong>Formula</strong></td>
                    <td>@Html.DisplayFor(model => model.Formula)</td>
                </tr>
                <tr>
                    <td><strong>Mascota</strong></td>
                    <td>@Html.DisplayFor(model => model.Mascota.Nombre)</td>
                </tr>
                <tr>
                    <td><strong>Médico</strong></td>
                    <td>@Html.DisplayFor(model => model.Medico.Nombre)</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="center-align">
    <form asp-action="Delete" style="display: inline;">
        <input type="hidden" asp-for="id" />
        <button type="submit" class="btn waves-effect waves-light red darken-2" style="padding: 0px 8px; font-size: 12px; border-radius: 8px;">
            <i class="material-icons left">delete</i>Eliminar
        </button>
    </form>
    <a asp-action="Index" class="waves-effect waves-light"
       style="color: #2196F3; text-decoration: none; font-size: 16px; display: inline-flex; align-items: center;">
        <i class="material-icons left" style="font-size: 16px; margin-right: 4px;">arrow_back</i> Volver a la Lista
    </a>
</div>

